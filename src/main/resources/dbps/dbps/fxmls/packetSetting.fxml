      <Button layoutX="194.0" layoutY="127.0" mnemonicParsing="false" prefHeight="28.0" prefWidth="63.0" text="%setting" onMouseClicked="#setPacket"/>
      <Button layoutX="269.0" layoutY="127.0" mnemonicParsing="false" prefHeight="28.0" prefWidth="63.0" text="%close" onMouseClicked="#close"/>
    </Pane>
</AnchorPane>