<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane fx:id="psAP" prefHeight="186.0" prefWidth="373.0" style="-fx-background-color: #333333" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.PacketSettingController">
    <Pane layoutX="12.0" layoutY="11.0" prefHeight="163.0" prefWidth="350.0" style="-fx-border-color: black;-fx-border-width: 1px">
        <Label layoutX="20.0" layoutY="-8.0" text="Data Packing Condition" />
        <Label layoutX="20.0" layoutY="35.0" text="Char(ASCII) 1st" />
        <TextField fx:id="ascFirst" layoutX="145.0" layoutY="30.0" prefHeight="21.0" prefWidth="70.0" />
        <Label layoutX="220.0" layoutY="35.0" text="2nd" />
        <TextField fx:id="ascSecond" layoutX="260.0" layoutY="30.0" prefHeight="21.0" prefWidth="70.0" />
        <Label layoutX="20.0" layoutY="69.0" text="Char(HEX) 1st" />
        <TextField fx:id="hexFirst" layoutX="145.0" layoutY="65.0" prefHeight="21.0" prefWidth="70.0" />
        <Label layoutX="220.0" layoutY="69.0" text="2nd" />
        <TextField fx:id="hexSecond" layoutX="260.0" layoutY="65.0" prefHeight="21.0" prefWidth="70.0" />
        <Label layoutX="20.0" layoutY="104.0" text="Timeout(ms)" />
        <TextField fx:id="timeOut" layoutX="145.0" layoutY="100.0" prefHeight="21.0" prefWidth="70.0" />
