<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="339.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.BoardInfoReadController">
    <Pane layoutX="15.0" layoutY="14.0" prefHeight="87.0" prefWidth="420.0">
        <Label layoutX="14.0" layoutY="-6.0" text="밝기 정보"/>
        <TextField layoutX="23.0" layoutY="38.0" prefHeight="24.0" prefWidth="189.0"/>
        <Button layoutX="347.0" layoutY="32.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="65.0"
                onMouseClicked="#readBrightness" text="%read"/>
    </Pane>
    <Pane layoutX="15.0" layoutY="110.0" prefHeight="87.0" prefWidth="420.0">
        <Label layoutX="14.0" layoutY="-6.0" text="화면 크기 정보"/>
        <TextField layoutX="23.0" layoutY="38.0" prefHeight="24.0" prefWidth="59.0"/>
        <Button layoutX="347.0" layoutY="32.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="65.0"
