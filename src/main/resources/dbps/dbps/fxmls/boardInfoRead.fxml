        <TextField layoutX="89.0" layoutY="38.0" prefHeight="24.0" prefWidth="80.0"/>
        <Button layoutX="347.0" layoutY="32.0" mnemonicParsing="false" prefHeight="36.0" onMouseClicked="#readCPU"
