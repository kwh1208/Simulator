        <Label layoutX="14.0" layoutY="43.0" text="펌웨어 정보"/>
        <Label layoutX="186.0" layoutY="43.0" text="CPU 속도"/>
        <TextField layoutX="251.0" layoutY="38.0" prefHeight="24.0" prefWidth="88.0"/>
    </Pane>
    <Button layoutX="364.0" layoutY="295.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="65.0" text="%close"/>
