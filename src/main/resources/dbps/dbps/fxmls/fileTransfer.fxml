<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dbps.dbps.controller.FileController"
            prefHeight="400.0" prefWidth="600.0">
    <!-- 파일 열기 버튼 -->
    <Button fx:id="openButton" text="파일 열기" layoutX="100.0" layoutY="180.0" onAction="#handleOpen"/>
    <!-- 파일 전송 버튼 -->
    <Button fx:id="sendButton" text="파일 전송" layoutX="250.0" layoutY="180.0" onAction="#handleSend"/>
    <!-- 파일 수신 버튼 -->
    <Button fx:id="receiveButton" text="파일 수신" layoutX="400.0" layoutY="180.0" onAction="#handleReceive"/>
</AnchorPane>
