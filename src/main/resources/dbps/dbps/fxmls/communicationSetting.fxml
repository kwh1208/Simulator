<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="communicationSettingAP" prefHeight="680.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.CommunicationSettingController">
    <Pane layoutX="15.0" layoutY="14.0" prefHeight="153.0" prefWidth="373.0" style="-fx-border-color: #A0A0A0 ; -fx-border-radius: 10; -fx-border-width: 0.3">
        <RadioButton fx:id="serialRadioBtn" layoutX="14.0" layoutY="-8.0" mnemonicParsing="false" prefHeight="16.0" style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5px" text="Serial" />
        <Label layoutX="14.0" layoutY="21.0" prefHeight="16.0" text="%comPort" />
        <ComboBox fx:id="serialPortComboBox" layoutX="210.0" layoutY="17.0" prefHeight="25.0" prefWidth="145.0" value="COM1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="COM1" />
                </FXCollections>
            </items>
        </ComboBox>

        <Label layoutX="14.0" layoutY="53.0" prefHeight="16.0" text="%baudrateSetting" />
        <ComboBox fx:id="serialSpeedComboBox" layoutX="210.0" layoutY="49.0" prefHeight="25.0" prefWidth="145.0" value="115200">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="9600" />
                    <String fx:value="19200" />
                    <String fx:value="38400" />
                    <String fx:value="57600" />
                    <String fx:value="115200" />
                    <String fx:value="230400" />
                    <String fx:value="460800" />
                    <String fx:value="921600" />
                </FXCollections>
            </items>
        </ComboBox>
        <CheckBox fx:id="RS485ChkBox" layoutX="14.0" layoutY="85.0" mnemonicParsing="false" text="RS-485 Address" />
        <ComboBox fx:id="RS485ComboBox" layoutX="210.0" layoutY="81.0" prefHeight="25.0" prefWidth="145.0" visible="false">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>
        <Button fx:id="findSpeedBtn" focusTraversable="false" layoutX="135.0" layoutY="115.0" mnemonicParsing="false" onMouseClicked="#findCommunicationSpeed" prefHeight="27.0" prefWidth="110.0" text="%findBaudrate" />
        <Button fx:id="openDeviceManagerBtn" focusTraversable="false" layoutX="250.0" layoutY="115.0" mnemonicParsing="false" onMouseClicked="#openDeviceManager" prefHeight="27.0" prefWidth="105.0" styleClass="newWindow-button" text="%deviceManager">
        </Button>

    </Pane>
    <Pane layoutX="15.0" layoutY="182.0" prefHeight="117.0" prefWidth="373.0" style="-fx-border-color: #A0A0A0; -fx-border-radius: 10; -fx-border-width: 0.3">
        <RadioButton fx:id="clientTCPRadioBtn" layoutX="14.0" layoutY="-8.0" mnemonicParsing="false" prefHeight="16.0" style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5px" text="Client TCP/IP" />
        <Label layoutX="13.0" layoutY="21.0" prefHeight="16.0" text="IP Address" />
        <TextField fx:id="clientIPAddress" layoutX="210.0" layoutY="17.0" prefHeight="25.0" prefWidth="145.0" text="192.168.0.201">
        </TextField>
        <Label layoutX="13.0" layoutY="53.0" prefHeight="16.0" text="IP Port" />
        <TextField fx:id="clientIPPort" layoutX="210.0" layoutY="49.0" prefHeight="25.0" prefWidth="145.0" text="5000">
        </TextField>
        <Label layoutX="13.0" layoutY="85.0" prefHeight="16.0" text="PingTest" />
        <TextField fx:id="pingTextField" layoutX="210.0" layoutY="81.0" prefHeight="25.0" prefWidth="95.0" />
        <Button fx:id="pingTestBtn" focusTraversable="false" layoutX="310.0" layoutY="81.0" mnemonicParsing="false" onMouseClicked="#pingTest" prefHeight="25.0" prefWidth="45.0" text="%Run" />
    </Pane>

    <Pane layoutX="15.0" layoutY="314.0" prefHeight="85.0" prefWidth="373.0" style="-fx-border-color: #A0A0A0; -fx-border-radius: 10; -fx-border-width: 0.3">
        <RadioButton fx:id="serverTCPRadioBtn" layoutX="16.0" layoutY="-8.0" mnemonicParsing="false" prefHeight="16.0" style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5px" text="Server TCP/IP" />
        <Label layoutX="16.0" layoutY="21.0" prefHeight="16.0" text="IP Address" />
        <ComboBox fx:id="serverIPAddress" layoutX="210.0" layoutY="17.0" prefHeight="25.0" prefWidth="145.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>
        <Label layoutX="16.0" layoutY="53.0" prefHeight="16.0" text="IP Port" />
        <TextField fx:id="serverIPPort" layoutX="210.0" layoutY="49.0" prefHeight="25.0" prefWidth="145.0" />
    </Pane>
    <Pane layoutX="15.0" layoutY="414.0" prefHeight="85.0" prefWidth="373.0" style="-fx-border-color: #A0A0A0; -fx-border-radius: 10; -fx-border-width: 0.3">
        <RadioButton fx:id="UDPRadioBtn" layoutX="18.0" layoutY="-8.0" mnemonicParsing="false" prefHeight="16.0" style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5px" text="UDP" />
        <Label layoutX="16.0" layoutY="21.0" prefHeight="16.0" text="IP Address" />
        <TextField fx:id="UDPIPAddress" layoutX="210.0" layoutY="17.0" prefHeight="25.0" prefWidth="145.0" text="192.168.0.202" />
        <Label layoutX="16.0" layoutY="53.0" prefHeight="16.0" text="IP Port" />
        <TextField fx:id="UDPIPPort" layoutX="210.0" layoutY="49.0" prefHeight="25.0" prefWidth="145.0" text="5108" />
    </Pane>

    <Pane fx:id="mqttPane" layoutX="15.0" layoutY="514.0" prefHeight="58.0" prefWidth="373.0" style="-fx-border-color: #A0A0A0; -fx-border-radius: 10; -fx-border-width: 0.3">
        <RadioButton fx:id="mqttRadio" layoutX="18.0" layoutY="-8.0" mnemonicParsing="false" prefHeight="16.0" style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5px" text="MQTT" />
        <Button layoutX="19.0" layoutY="20.0" mnemonicParsing="false" onMouseClicked="#openMqttSetting" prefHeight="27.0" prefWidth="151.0" text="MQTT Setting" />
        <Button layoutX="198.0" layoutY="20.0" mnemonicParsing="false" onMouseClicked="#openMqttServer" prefHeight="27.0" prefWidth="151.0" text="MQTT Server" />
    </Pane>

    <Button fx:id="connect" focusTraversable="false" layoutX="17.0" layoutY="577.0" mnemonicParsing="false" onMouseClicked="#openSerialPort" prefHeight="27.0" prefWidth="115.0" text="%openPort" />
    <Button fx:id="keepOpenBtn" focusTraversable="false" layoutX="143.0" layoutY="577.0" mnemonicParsing="false" onMouseClicked="#keepOpen" prefHeight="27.0" prefWidth="115.0" text="%portkeep" />
    <Button fx:id="shutConnect" focusTraversable="false" layoutX="269.0" layoutY="577.0" mnemonicParsing="false" onMouseClicked="#closeSerialPort" prefHeight="27.0" prefWidth="115.0" text="%closePort" />
    <Button focusTraversable="false" layoutX="17.0" layoutY="609.0" mnemonicParsing="false" onMouseClicked="#openDabitNet" prefHeight="27.0" prefWidth="115.0" styleClass="newWindow-button" text="dbNet">
    </Button>
    <Button focusTraversable="false" layoutX="143.0" layoutY="609.0" mnemonicParsing="false" onMouseClicked="#openBluetooth" prefHeight="27.0" prefWidth="115.0" styleClass="newWindow-button" text="dbBle">
    </Button>
    <Button focusTraversable="false" layoutX="269.0" layoutY="609.0" minWidth="115.0" mnemonicParsing="false" onMouseClicked="#controllerConnect" prefHeight="27.0" text="%connect" />
    <Label layoutX="19.0" layoutY="645.0" prefHeight="16.0" text="%responseTime" />
    <ComboBox fx:id="delayTime" layoutX="105.0" layoutY="641.0" prefHeight="25.0" prefWidth="54.0" value="3">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="1" />
                <String fx:value="2" />
                <String fx:value="3" />
                <String fx:value="4" />
                <String fx:value="5" />
                <String fx:value="6" />
            </FXCollections>
        </items>
    </ComboBox>
    <Label layoutX="164.0" layoutY="645.0" prefHeight="16.0" text="초" />
    <Button focusTraversable="false" layoutX="269.0" layoutY="641.0" mnemonicParsing="false" onMouseClicked="#communicationSettingClose" prefHeight="27.0" prefWidth="115.0" text="%close" />
    <ProgressIndicator fx:id="progressIndicator" layoutX="170.0" layoutY="240.0" visible="false" />
</AnchorPane>
