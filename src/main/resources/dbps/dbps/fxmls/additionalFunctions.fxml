<AnchorPane fx:id="additionalFunctionAp" prefHeight="440.0" prefWidth="400.0" style="-fx-background-color: #333333" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.AdditionalFunctionsController">
