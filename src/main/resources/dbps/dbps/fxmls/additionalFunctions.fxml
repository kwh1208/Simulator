            <FXCollections fx:factory="observableArrayList">
            </FXCollections>
        </items>
    </ComboBox>
    <Button layoutX="321.0" layoutY="35.0" mnemonicParsing="false" onMouseClicked="#sendDisplaySpeed" prefHeight="28.0" prefWidth="63.0" text="%set" />


    <Label layoutX="28.0" layoutY="75.0" text="%blinkCount" />
