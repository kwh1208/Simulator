            text="%fontSetting" onMouseClicked="#fontSetting"/>
    <Button layoutX="20.0" layoutY="110.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="210.0"
            text="%displaySignalSetting" onMouseClicked="#transferSignalSetting"/>
    <Button layoutX="20.0" layoutY="160.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="210.0"
            text="%boardSetting" onMouseClicked="#boardSetting"/>
    <Button layoutX="20.0" layoutY="210.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="210.0"
            text="%firmwareUpgrade" onMouseClicked="#firmwareInfo"/>
</Pane>