<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane fx:id="bluetoothAP" prefHeight="248.0" prefWidth="347.0" style="-fx-background-color: #333333;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.BlueToothController">
    <Pane layoutX="15.0" layoutY="15.0" prefHeight="218.0" prefWidth="315.0" style="-fx-border-color: black">
        <Label layoutX="27.0" layoutY="20.0" text="%comPort" />
        <ComboBox fx:id="serialPortComboBox" layoutX="153.0" layoutY="16.0" prefHeight="22.0" prefWidth="152.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>
        <Label layoutX="27.0" layoutY="60.0" text="%BLEName" />
        <TextField fx:id="ble_id" layoutX="152.0" layoutY="56.0" prefHeight="21.0" prefWidth="152.0" style="-fx-background-color: black; -fx-text-fill: white"/>
        <Label layoutX="27.0" layoutY="100.0" text="%BLEPwd" />
        <TextField fx:id="ble_password" layoutX="152.0" layoutY="96.0" prefHeight="21.0" prefWidth="152.0" style="-fx-background-color: black; -fx-text-fill: white"/>
        <Button layoutX="16.0" layoutY="133.0" mnemonicParsing="false" onMouseClicked="#search" prefHeight="27.0" prefWidth="90.0" text="%search" />
        <Button layoutX="216.0" layoutY="133.0" mnemonicParsing="false" onMouseClicked="#set" prefHeight="27.0" prefWidth="90.0" text="%setting" />
        <Button layoutX="16.0" layoutY="171.0" mnemonicParsing="false" onMouseClicked="#begin" prefHeight="27.0" prefWidth="90.0" text="%beginBLE" />
        <Button layoutX="116.0" layoutY="171.0" mnemonicParsing="false" onMouseClicked="#end" prefHeight="27.0" prefWidth="90.0" text="%endBLE" />
        <Button layoutX="216.0" layoutY="171.0" mnemonicParsing="false" onMouseClicked="#close" prefHeight="27.0" prefWidth="90.0" text="%close" />
        <ProgressIndicator fx:id="progressIndicator" layoutX="180.0" layoutY="70.0" visible="false" />
    </Pane>
</AnchorPane>
