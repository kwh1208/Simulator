<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefHeight="222.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.ASCheckController">
    <Pane layoutX="24.0" layoutY="27.0" prefHeight="105.0" prefWidth="332.0">
        <Label layoutX="14.0" layoutY="-14.0" text="체크사항"/>
        <Label layoutX="20.0" layoutY="20.0" text="1. 통신이 제대로 연결되어있나요?"/>
        <Button layoutX="245.0" layoutY="16.0" onMouseClicked="#connectionTest" mnemonicParsing="false"
                prefHeight="22.0" prefWidth="79.0" text="확인하기"/>
        <Label layoutX="20.0" layoutY="51.0" text="2. 화면설정을 모듈에 맞게 설정하셨나요?"/>
        <Button layoutX="245.0" layoutY="46.0" mnemonicParsing="false" onMouseClicked="#goDocs" prefHeight="22.0"
                prefWidth="79.0" text="공식문서"/>
        <Label layoutX="20.0" layoutY="82.0" text="3. 글씨가 이상하게 나와요"/>
        <Button layoutX="245.0" layoutY="78.0" mnemonicParsing="false" prefHeight="22.0" prefWidth="79.0"
                text="FAQ 확인" onMouseClicked="#goFAQ"/>
    </Pane>
    <Button layoutX="207.0" layoutY="188.0" mnemonicParsing="false" onMouseClicked="#openAS" text="AS 문의하러 가기"/>
    <Button layoutX="55.0" layoutY="187.0" mnemonicParsing="false" onMouseClicked="#copyController" prefHeight="22.0"
            prefWidth="121.0" text="컨트롤러 정보 복사"/>
    <Label layoutX="44.0" layoutY="142.0" text="위의 체크 사항으로 해결하지 못하셨나요?"/>
    <Label layoutX="44.0" layoutY="162.0" text="아래 버튼을 누른후 AS 문서에 추가해주세요."/>
</AnchorPane>
