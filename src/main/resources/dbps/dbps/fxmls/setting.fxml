<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="605.0" prefWidth="590.0"
            style="-fx-border-color: black; -fx-border-width: 1 0 0 0" xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.SettingController">
    <!--프로그램 설정-->
    <fx:include source="basicSetting.fxml"/>
    <!--고급 설정-->
    <fx:include source="advancedSetting.fxml"/>

    <!--전광판 크기-->
    <fx:include source="sizeOfDisplayBoard.fxml"/>

    <Label layoutX="315.0" layoutY="356.0" text="%sectionEffect"/>
    <ChoiceBox fx:id="pageMsgType" layoutX="430.0" layoutY="351.0" prefHeight="25.0" prefWidth="87.0">
        <items>
            <FXCollections fx:factory="observableArrayList">
            </FXCollections>
        </items>
    </ChoiceBox>
    <Button layoutX="525.0" layoutY="350.0" mnemonicParsing="false" onMouseClicked="#sendPageMsgType" prefHeight="28.0"
            prefWidth="63.0" text="%sendButton"/>
    <!--선아래 왼쪽-->
    <fx:include source="underTheLineLeft.fxml"/>

    <!--선아래 오른쪽-->
    <fx:include source="underTheLineRight.fxml"/>
    <ProgressIndicator fx:id="commonProgressIndicator" layoutX="320.0" layoutY="200.0" visible="false"/>
</AnchorPane>
