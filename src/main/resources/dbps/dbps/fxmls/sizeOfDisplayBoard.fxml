<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane fx:id="dpPane" layoutX="260.0" layoutY="60.0" prefHeight="250.0" prefWidth="320.0"
      style="-fx-border-color: #4A4A4A; -fx-border-radius: 10" xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="dbps.dbps.controller.SizeOfDisplayBoardController">
    <Label alignment="CENTER" layoutX="85.0" layoutY="-14.0" prefHeight="18.0" prefWidth="140.0"
           style="-fx-background-color: #4A4A4A; -fx-padding: 5px; -fx-text-fill: white; -fx-font-weight: bolder"
           text="%displaySize" textFill="WHITE"/>
    <Label layoutX="20.0" layoutY="25.0" text="%height"/>
    <Spinner fx:id="spinnerForRow" layoutX="170.0" layoutY="18.0" prefHeight="25.0" prefWidth="64.0"/>
    <Label layoutX="240.0" layoutY="26.0" prefHeight="13.0" prefWidth="80.0" text="X16 Pixels"/>

    <Label layoutX="20.0" layoutY="56.0" text="%width"/>
    <Spinner fx:id="spinnerForColumn" layoutX="170.0" layoutY="51.0" prefHeight="25.0" prefWidth="64.0"/>
    <Label layoutX="240.0" layoutY="58.0" prefHeight="13.0" prefWidth="80.0" text="X16 Pixels"/>

    <Label layoutX="20.0" layoutY="87.0" text="%moduleArrangementMethod"/>
    <ChoiceBox fx:id="howToArray" layoutX="130.0" layoutY="82.0" prefHeight="25.0" prefWidth="135.0">
        <items>
            <FXCollections fx:factory="observableArrayList">
            </FXCollections>
        </items>
    </ChoiceBox>
    <Button layoutX="265.0" layoutY="82.0" mnemonicParsing="false" onMouseClicked="#sendDisplaySize" prefHeight="28.0"
            prefWidth="50.0" text="%sendButton"/>
    <Label layoutX="20.0" layoutY="115.0" text="%displayBrightness"/>
    <ChoiceBox fx:id="displayBright" layoutX="140.0" layoutY="115.0" prefHeight="25.0" prefWidth="87.0" value="100%">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="100%"/>
                <String fx:value="75%"/>
                <String fx:value="50%"/>
                <String fx:value="25%"/>
                <String fx:value="5%"/>
            </FXCollections>
        </items>
    </ChoiceBox>
    <Button layoutX="265.0" layoutY="115.0" mnemonicParsing="false" onMouseClicked="#sendDisplayBright"
            prefHeight="28.0" prefWidth="50.0" text="%sendButton"/>
</Pane>
